# Supabase Configuration
# Obtén estas credenciales desde tu proyecto en https://supabase.com/dashboard
SUPABASE_PROJECT_ID=tu_project_id
SUPABASE_PUBLISHABLE_KEY=tu_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_URL=https://tu_project_id.supabase.co

# Variables para el cliente (Vite)
VITE_SUPABASE_PROJECT_ID=tu_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=tu_anon_public_key
VITE_SUPABASE_URL=https://tu_project_id.supabase.co

# Códigos de acceso del sistema
VITE_CODIGO_COORDINADOR=COORD2024
VITE_CODIGO_ENCARGADO=ENCARG2024
