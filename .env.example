# Configuración de Supabase para desarrollo local y despliegue.
# Copia este archivo a .env y completa los valores del mismo proyecto Supabase.

# Variables públicas incluidas en el bundle del navegador durante el build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Variables del servidor Node.js.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Opcional: solo si las funciones del servidor requieren permisos que omiten RLS.
# Nunca uses una clave sb_secret o service_role en variables VITE_* ni la publiques.
# SUPABASE_SERVICE_ROLE_KEY=
